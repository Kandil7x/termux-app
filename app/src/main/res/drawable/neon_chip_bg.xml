<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFF2BD6" />
            <stroke android:width="1dp" android:color="@color/neon_magenta" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_surface_raised" />
            <stroke android:width="1dp" android:color="#8000F0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
